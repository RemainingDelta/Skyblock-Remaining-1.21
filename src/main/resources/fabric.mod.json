{
	"schemaVersion": 1,
	"id": "skyblockremaining",
    "version": "${version}",
	"name": "SkyblockRemaining",
	"description": "A client-side Skyblock utility mod providing quality-of-life HUD overlays for Hypixel Skyblock.",
	"authors": [
		"RemainingDelta"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/skyblockremaining/icon.png",
	"environment": "*",
    "entrypoints": {
      "main": [
        "com.remainingdelta.SkyblockRemaining"
      ],
      "client": [
        "com.remainingdelta.SkyblockRemainingClient"
      ],
      "modmenu": [
        "com.remainingdelta.ModMenuIntegration"
      ]
    },
	"mixins": [
		"skyblockremaining.mixins.json",
		{
			"config": "skyblockremaining.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}